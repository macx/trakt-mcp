# Copy to .env and fill in. Never commit .env.

# Your Trakt development app (https://app.trakt.tv/settings/apps).
# Sign-in uses Trakt's device flow; the app only needs a localhost redirect URI.
TRAKT_CLIENT_ID=
# Optional client secret, sent to Trakt's token endpoints if set.
TRAKT_CLIENT_SECRET=
# Must be a redirect URI registered for the app (Trakt expects it on token refresh).
# TRAKT_REDIRECT_URI=http://localhost:8000/trakt/callback

# Public HTTPS URL of this server (no path). The MCP endpoint is <PUBLIC_URL>/mcp.
PUBLIC_URL=https://mcp.example.com

# Comma-separated Trakt slugs (as in trakt.tv/users/<slug>) allowed to sign in.
ALLOWED_TRAKT_USERS=your-trakt-username

# Optional: redirect URIs MCP clients may register (comma-separated).
# Default: Claude (claude.ai / claude.com) and loopback URIs for local clients.
# ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost/*,http://127.0.0.1/*

# Network of your reverse proxy, so per-IP rate limits see real client addresses.
# TRUSTED_PROXIES=172.18.0.0/16

# LOG_LEVEL=INFO
